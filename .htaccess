# The domain's document root is the repository root, so send every request
# to Laravel's public/ directory (which has its own .htaccess).
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Never serve dotfiles other than .well-known (.env, .git, ...).
    RewriteRule "(^|/)\.(?!well-known)" - [F]

    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
